# --- data (structure is tracked via .gitkeep, contents are not) ---
# The directory re-include is required: git will not descend into an excluded
# directory, so without it the .gitkeep negation below can never match.
# `data/profile.md` is in here on purpose: it holds employer, projects and language
# weaknesses. `docs/profile.example.md` is the tracked seed it is copied from.
# `data/learning-notes.md` is covered for the same reason, seeded from
# `docs/learning-notes.example.md`.
data/**
!data/**/
!data/**/.gitkeep

# A stray profile at the pre-move path must never be committed either.
docs/profile.md

# Recordings and stray data trees from running commands outside the repo root.
backend/data/

# --- models / caches ---
models/
.cache/
*.bin
*.pt
*.ct2

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- node ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- env / local ---
.env
.env.local
*.log

# --- os / editor ---
Thumbs.db
.DS_Store
.idea/
